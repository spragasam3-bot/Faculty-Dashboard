# ==============================================================================
# Faculty Performance and Academic Activity Dashboard - Environment Variables
# Copy this file to .env and customize the values for your deployment.
# ==============================================================================

# Cryptographic secret used to sign JWT access tokens.
# IMPORTANT: Generate a strong, random 32+ character string in production.
# Example generator: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_signing_secret_key_at_least_32_chars

# Access token lifetime in minutes (e.g., 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default initial administrator account created on first database initialization
ADMIN_NAME=Institutional Administrator
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=Admin@123
